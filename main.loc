--' Rust implementations of the functions bio specifies
module bio-rust (*)

import bio
import root-rust
import vector-rust
import stream-rust

type Rust => Genome = "BioGenome"
type Rust => Transcript = "BioTranscript"
data Rust => Strand = "BioStrand"
data Rust => Orient = "BioOrient"
record Rust => Segment = "BioSegment"
record Rust => (Loc k) = "BioLoc<$1>" k
record Rust => Block = "BioBlock"
record Rust => (Mapping a b) = "BioMapping<$1,$2>" a b
data Rust => (Piece k) = "BioPiece<$1>" k
record Rust => (Sequence a s) = "BioSequence<$1,$2>" a s
record Rust => BaseQual = "BioBaseQual"
record Rust => (Feature n) = "BioFeature<$1>" n
record Rust => (Root s n) = "BioRoot<$1,$2>" s n
record Rust => GffNode = "BioGffNode"
record Rust => GtfLine = "BioGtfLine"
record Rust => Bed3 = "BioBed3"
record Rust => Bed6 = "BioBed6"
record Rust => Bed12 = "BioBed12"
record Rust => TxModel = "BioTxModel"
record Rust => RefModels = "BioRefModels"
data Rust => Phase = "BioPhase"
record Rust => Cds = "BioCds"
record Rust => GeneTx = "BioGeneTx"
record Rust => Gene = "BioGene"
record Rust => Complexity = "BioComplexity"
data Rust => GffEntry = "BioGffEntry"
data Rust => LibStrand = "BioLibStrand"
data Rust => Layout = "BioLayout"
record Rust => TxHit = "BioTxHit"
record Rust => FragHits = "BioFragHits"
record Rust => TxGene = "BioTxGene"

source Rust from "bio.rs"
  ( "bio_tiled" as tiled
  , "bio_invert" as invert
  , "bio_compose_blocks" as composeBlocks
  , "bio_project" as project
  , "bio_project_many" as projectMany
  , "bio_extract" as extract
  , "bio_extract_blocks" as extractBlocks
  , "bio_transcript_models" as transcriptModels
  , "bio_gff_entries" as gffEntries
  , "bio_entry_roots" as entryRoots
  , "bio_entry_seqid" as entrySeqid
  , "bio_rust_anchor" as bioRustAnchor
  , "bio_attr_values" as attrValues
  , "bio_stream_fastq_pairs" as readFastqPairs
  , "bio_write_fastq_pairs" as writeFastqPairs
  , "bio_format_fasta" as formatFasta
  , "bio_format_fastq" as formatFastq
  , "bio_format_bed3" as formatBed3
  , "bio_format_bed6" as formatBed6
  , "bio_format_bed12" as formatBed12
  , "bio_format_gff3" as formatGff3
  , "bio_format_gtf" as formatGtf
  , "bio_stream_gtf_filtered" as readGtfFiltered
  , "bio_fasta_names" as fastaNames
  , "bio_write_transcript_fasta" as writeTranscriptFasta
  , "bio_write_transcript_fasta_pull" as writeTranscriptFastaPullNative
  , "bio_write_fasta_pull" as writeFastaPullNative
  , "bio_stream_gtf_lines" as readGtfLines
  , "bio_gtf_trees" as gtfTrees
  , "bio_filter_gtf_lines" as filterGtfLines
  , "bio_tx_genes" as txGenes
  , "bio_open_pairs" as openPairs
  , "bio_next_pairs" as nextPairsNative
  , "bio_open_reads" as openReads
  , "bio_ref_models" as refModels
  , "bio_project_point" as projectPoint
  , "bio_next_reads" as nextReadsNative
  , "bio_append_text" as appendText
  , "bio_reset_file" as resetFile
  )

-- Identity on Int. Natives of other modules that name bio-rust types take
-- its result, so that bio.rs is compiled into their pools.
bioRustAnchor :: Int -> Int

compose ab bc
  ? .dst ab == .src bc = Ok (composeBlocks ab bc)
  : Err "compose: the mappings do not share a middle sequence"

instance StreamFormattable (Fasta FastaEntry) where
  source Rust from "bio.rs" ("bio_stream_fasta" as readFormat, "bio_write_fasta" as writeFormat)

instance StreamFormattable (Fastq FastqEntry) where
  source Rust from "bio.rs" ("bio_stream_fastq" as readFormat, "bio_write_fastq" as writeFormat)

instance StreamFormattable (Gff3 (Root Str GffNode)) where
  source Rust from "bio.rs" ("bio_stream_gff3" as readFormat, "bio_write_gff3" as writeFormat)

instance StreamFormattable (Gtf (Root Str GffNode)) where
  source Rust from "bio.rs" ("bio_stream_gtf" as readFormat, "bio_write_gtf" as writeFormat)

instance StreamFormattable (Bed Bed3) where
  source Rust from "bio.rs" ("bio_stream_bed3" as readFormat, "bio_write_bed3" as writeFormat)

instance StreamFormattable (Bed Bed6) where
  source Rust from "bio.rs" ("bio_stream_bed6" as readFormat, "bio_write_bed6" as writeFormat)

instance StreamFormattable (Bed Bed12) where
  source Rust from "bio.rs" ("bio_stream_bed12" as readFormat, "bio_write_bed12" as writeFormat)
